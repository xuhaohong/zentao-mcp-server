{
  "name": "zentao-mcp-installer",
  "version": "0.1.3",
  "description": "A local stdio MCP server for ZenTao with one-command installer",
  "type": "module",
  "private": false,
  "author": "bibilabu",
  "repository": {
    "type": "git",
    "url": "https://github.com/xuhaohong/zentao-mcp-server.git"
  },
  "bin": {
    "zentao-mcp-server": "./dist/index.js",
    "zentao-mcp-install": "./dist/installer.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "install-mcp": "node dist/installer.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "zentao",
    "stdio",
    "model-context-protocol",
    "claude",
    "cursor",
    "ai-assistant"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "chalk": "^5.6.2",
    "inquirer": "^9.3.8",
    "ora": "^7.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
